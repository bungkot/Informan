# Copy to .env:  cp .env.example .env

# Ollama model. With a total of 3g (Ollama 2g + dev/app 1g) only 1.5b-3b fit.
OLLAMA_MODEL=qwen2.5-coder:3b

# Ollama container memory limit. Default stack: 2g + 1g (dev/app) = 3g total.
# Must be < Docker Desktop memory (leave >= 1g for dev/app and Docker).
OLLAMA_MEM_LIMIT=2g

# dev/app container memory limits.
DEV_MEM_LIMIT=1g
APP_MEM_LIMIT=1g

# Context length. Coding agents need a large context, but the KV cache eats RAM.
# 8192 so a 3b model fits within the 2g cap (q8_0 KV cache + flash attention).
OLLAMA_CONTEXT_LENGTH=8192

# Used when OpenCode/SDK runs ON THE HOST (not in a container).
# Inside containers this value is overridden to http://ollama:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
