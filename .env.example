# Salin ke .env:  cp .env.example .env

# Model Ollama. Dengan total 3g (Ollama 2g + dev/app 1g) hanya 1.5b-3b yang muat.
OLLAMA_MODEL=qwen2.5-coder:3b

# Batas memori container Ollama. Default stack: 2g + 1g (dev/app) = 3g total.
# Harus < memori Docker Desktop (sisakan >= 1g untuk dev/app dan Docker).
OLLAMA_MEM_LIMIT=2g

# Batas memori container dev/app.
DEV_MEM_LIMIT=1g
APP_MEM_LIMIT=1g

# Panjang konteks. Agent coding butuh konteks besar, tapi KV cache memakan RAM.
# 8192 agar model 3b muat dalam batas 2g (KV cache q8_0 + flash attention).
OLLAMA_CONTEXT_LENGTH=8192

# Dipakai saat OpenCode/SDK berjalan DI HOST (bukan di container).
# Di dalam container nilai ini di-override ke http://ollama:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
